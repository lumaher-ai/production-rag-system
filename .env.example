APP_NAME=production_rag
ENVIRONMENT=development
DEBUG=true
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=DEBUG
DATABASE_URL=postgresql+asyncpg://paddington:paddington_dev_password@localhost:5432/paddington
JWT_SECRET_KEY=local-dev-secret-key-not-for-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
DEFAULT_MODEL=gpt-4o-mini
FALLBACK_MODEL=claude-haiku-4-5-20251001
# 100 MiB. Sized for image-heavy PDFs: a 384-page book measured 91 MiB on disk
# but only ~250K chars of text, so byte size is a poor proxy for ingestion cost.
# Note this bounds a SYNCHRONOUS ingest — a file near the cap holds an HTTP
# request and a DB transaction open for ~40s+ (see decision A2).
MAX_UPLOAD_BYTES=104857600
EMBEDDING_MODEL=text-embedding-3-small
QUERY_CACHE_TTL_SECONDS=3600
DEBUG_DIR=debug_runs

# ─── Background ingestion (arq worker) ───
# Run the worker alongside the API:  uv run arq production_rag.worker.WorkerSettings
REDIS_URL=redis://localhost:6379/0
# Chunks embedded and committed per batch. Sets resume granularity (a failure
# loses at most this much work) and bounds each embedding request.
INGESTION_BATCH_SIZE=100
INGESTION_JOB_TIMEOUT_SECONDS=3600
INGESTION_MAX_ATTEMPTS=3
# A 'running' job whose heartbeat is older than this is presumed orphaned (its
# worker was killed without recording a failure) and is re-queued. Must exceed
# how long one batch can take, or a healthy slow job would be picked up twice.
INGESTION_STALE_AFTER_SECONDS=300

# ─── Source connectors (POST /documents/ingest) ───
SOURCE_FETCH_TIMEOUT_SECONDS=120
SOURCE_FETCH_MAX_REDIRECTS=5
# Allow plaintext http:// sources. Development only.
ALLOW_INSECURE_HTTP_SOURCES=false
# Disables the SSRF guard that blocks fetches resolving to private/loopback/
# link-local addresses. NEVER set true in production: it exposes cloud metadata
# endpoints (169.254.169.254) and internal services to any authenticated caller.
ALLOW_PRIVATE_NETWORK_SOURCES=false
# Path to a Google service-account JSON key with Drive read access. The account
# must be granted access to each file. Empty disables the gdrive:// connector.
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/file.json

# ─── Ingestion quality gates ───
# Minimum characters per PDF page before the document is rejected as scanned.
# A page of prose runs 1,500-3,000 characters; a scan yields near zero. PDFs
# only — other formats have no pages to divide by.
INGESTION_MIN_CHARS_PER_PAGE=50

# ─── Document AI OCR (fallback extractor) ───
# Reads scanned PDFs, and is the ONLY way to ingest XLSX/XLSM/PPTX. Runs only
# when the local parser cannot do the job, because it bills ~$10 per 1,000 pages.
# Setup runbook (project, processor, IAM, bucket): docs/document-ai-setup.md
OCR_ENABLED=false
DOCUMENTAI_PROJECT_ID=
DOCUMENTAI_LOCATION=us
DOCUMENTAI_PROCESSOR_ID=
# Pinned, not floating: extraction output is an input to stored embeddings, so a
# model moving underneath us would silently change what a re-ingest produces.
DOCUMENTAI_PROCESSOR_VERSION=pretrained-layout-parser-v1.0-2024-06-03
# Needs roles/documentai.apiUser. Empty falls back to GOOGLE_SERVICE_ACCOUNT_FILE.
DOCUMENTAI_SERVICE_ACCOUNT_FILE=
# Cost guard, checked before the first API call — retries are automatic, so an
# unbounded scan is billed once per attempt.
DOCUMENTAI_MAX_PAGES=500
DOCUMENTAI_MAX_CONCURRENCY=4
# Online processing is capped at 15 pages per request. Above this page count,
# one batch job through Cloud Storage beats dozens of round trips.
DOCUMENTAI_BATCH_THRESHOLD_PAGES=60
# Required only for documents past the threshold above. Objects are deleted
# after each job; a short lifecycle rule is a backstop, not the cleanup.
DOCUMENTAI_GCS_BUCKET=
DOCUMENTAI_GCS_PREFIX=docai
# Must stay below INGESTION_JOB_TIMEOUT_SECONDS, or the worker kills the job
# while Google is still working and the retry starts over.
DOCUMENTAI_BATCH_TIMEOUT_SECONDS=900
